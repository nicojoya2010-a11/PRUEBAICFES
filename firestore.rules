rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return signedIn() && userDoc().data.status == "active";
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == "admin";
    }

    function isTeacherOrAdmin() {
      return isActive() && (userDoc().data.role == "teacher" || userDoc().data.role == "admin");
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.username is string
        && request.resource.data.usernameKey is string
        && request.resource.data.fullName is string
        && (
          (request.resource.data.role == "student" && request.resource.data.status == "active")
          || (request.resource.data.role == "teacher" && request.resource.data.status == "pending")
        );

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create: if isTeacherOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}
